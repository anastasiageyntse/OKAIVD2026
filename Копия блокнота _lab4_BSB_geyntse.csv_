{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[{"file_id":"1PC2SuDeGWyyuhHo_Ai15fwcDY1U6hiak","timestamp":1781710509949}],"authorship_tag":"ABX9TyMK3S366vwHnQcOjcVHpjxi"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"markdown","source":["Гейнце Анастасия Васильевна\n","\n","БСБ25-01\n","\n","Задание 4. Импорт, преобразование и экспорт данных средствами pandas"],"metadata":{"id":"bYV-ZyDd_Vnz"}},{"cell_type":"code","source":["import pandas as pd\n","import numpy as np\n","\n","# 1. Импорт данных\n","url = \"https://raw.githubusercontent.com/EvgeniiSopovGitHub/datasets_uni/main/okaivd/lab_4_raw_data.csv\"\n","df = pd.read_csv(url, sep=';', index_col=0)\n","\n","# Проверка наличия пропусков\n","print(\"Проверка пропусков до обработки:\")\n","print(df.info())\n","\n","df_filled = df.fillna(df.mean())\n","\n","print(\"\\nПроверка пропусков после обработки:\")\n","print(df_filled.info())\n","\n","df_filled['min'] = df_filled.min(axis=1)\n","df_filled['median'] = df_filled.median(axis=1)\n","df_filled['max'] = df_filled.max(axis=1)\n","\n","# Считаем математическое ожидание и стандартное отклонение по строкам\n","mean_vals = df_filled.mean(axis=1)\n","std_vals = df_filled.std(axis=1)\n","\n","df_filled['mean/std'] = (mean_vals.round(2).astype(str) + '/' + std_vals.round(2).astype(str))\n","\n","avg_row = df_filled.drop(columns=['mean/std']).mean()\n","avg_row['mean/std'] = np.nan\n","\n","df_final = pd.concat([df_filled, avg_row.to_frame().T.rename(index={0: 'average annual'})])\n","\n","# Проверка результата (head и tail)\n","print(\"\\nНачало DataFrame (head):\")\n","display(df_final.head())\n","\n","print(\"\\nКонец DataFrame (tail):\")\n","display(df_final.tail())\n","\n","filename = \"lab4_bsb2501_geyntse.csv\"\n","\n","df_final.to_csv(filename)\n"],"metadata":{"id":"-eHaZlHDm9kj","colab":{"base_uri":"https://localhost:8080/","height":1000},"executionInfo":{"status":"ok","timest